{%
  set classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  <div class="container bg-primary rounded-3 py-9 py-sm-12 d-flex flex-column mb-12 mb-sm-13">
    {% if label %}
      <h2{{ title_attributes.addClass(['text-white', 'fw-semibold', 'text-center', 'mb-7', 'mb-sm-9']) }}>{{ label }}</h2>
    {% endif %}
    {% block content %}
      <div{{ content_attributes.addClass('content') }}>
        {{ content }}
      </div>
    {% endblock %}
  </div>
  {{ title_suffix }}
</div>
